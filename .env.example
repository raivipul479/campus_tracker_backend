NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_tracker
DATABASE_URL=mysql://root:@127.0.0.1:3306/campus_tracker

# Live vehicle tracking provider. Proxied server-side (see gps.service.ts).
GPS_API_BASE_URL=https://navilap.com
GPS_API_USERNAME=your_gps_username

# Draws a bus's trail along the road instead of straight between GPS fixes
# (OSRM map matching, see road-snap.service.ts). The public server suits a small
# fleet; point ROUTING_API_BASE_URL at your own OSRM for heavier use.
# Set GOOGLE_ROADS_API_KEY to use the Google Roads API instead of OSRM. Keep it
# a server-only key, restricted to the Roads API.
# GOOGLE_ROADS_API_KEY=
# ROUTING_API_BASE_URL=https://router.project-osrm.org
# ROAD_SNAP_ENABLED=true

# Timezone for attendance days and a driver's "today" (IANA name).
SCHOOL_TIMEZONE=Asia/Kolkata
